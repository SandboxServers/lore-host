# Deploy-time configuration for the Lore server + lego TLS sidecar.
#
# Copy this to `.env` ON THE COLO BOX (next to compose.yml) and fill it in.
# `.env` is gitignored — NEVER commit real tokens. This repo is PUBLIC.
#
#   cp .env.example .env   # then edit
#
# Only the *public* domain belongs in version control (it is CT-logged
# anyway). The DNS-provider API token is a secret and is supplied via a
# mounted file, NOT a value here — see LE_DNS_TOKEN_FILE below.

# --- Network posture: VPN-only (private LAN bind) -------------------------
#
# Lore is reachable ONLY over the operators' existing UniFi (UCG Fiber)
# WireGuard VPN — never the public internet. lore-server runs with host
# networking and binds QUIC (41337/udp), gRPC (41337/tcp), and HTTP health
# (41339/tcp) to the host's PRIVATE LAN IP set here — never 0.0.0.0/WAN.
# (Lore ships auth-disabled, so a public bind would be an open door.)
#
# *** THIS VALUE IS NOT COMMITTED. *** Set it ONLY in the real `.env` on the
# box (gitignored). This repo is PUBLIC — do not put the real LAN IP in git.
# It must match the `host` value in /opt/lore/config/local.toml (the
# first-time-deploy `sed` step substitutes both from this file).
#
# Example shape only (RFC1918 private range — NOT the real address):
#   LORE_LAN_IP=10.x.y.z
LORE_LAN_IP=<LORE_LAN_IP>

# --- TLS / Let's Encrypt (lego DNS-01 sidecar) ----------------------------

# The public DNS name clients connect to and that the cert is issued for.
# Public / CT-logged — fine to keep here. Resolves to the PRIVATE LAN IP via
# split-horizon DNS for VPN clients; public DNS carries only the
# _acme-challenge TXT for Let's Encrypt. See RUNBOOK § split-horizon DNS.
LORE_DOMAIN=lore.sandboxservers.games

# ACME account contact (gets expiry-warning emails from Let's Encrypt).
LE_EMAIL=ops@sandboxservers.games

# lego DNS provider plugin name. The sandboxservers.games zone is hosted in
# **Azure DNS**, so this is `azuredns` (lego v5 provider name). See
# `lego dnshelp -c azuredns` for the full option list.
LE_DNS_PROVIDER=azuredns

# STAGING vs PRODUCTION Let's Encrypt.
#   true  = staging (UNTRUSTED certs, no rate-limit risk) — use for testing.
#   false = production (real, client-trusted certs) — set this ONLY on the
#           real colo box once DNS-01 is proven working in staging.
# Defaults to true in the sidecar if unset, so a fumbled deploy can't burn
# Let's Encrypt's strict production rate limits.
LE_STAGING=true

# --- Azure DNS credentials (lego `azuredns` provider) ---------------------
#
# Unlike single-token providers (Cloudflare etc.), Azure DNS authenticates a
# **service principal** with MULTIPLE values. lego's azuredns provider, in
# its client-secret mode, reads these env vars (source: lego upstream
# docs/content/dns/zz_gen_azuredns.md):
#
#   AZURE_AUTH_METHOD     = env   (pin client-secret-from-env auth explicitly)
#   AZURE_CLIENT_ID       = the service principal's Application (client) ID
#   AZURE_TENANT_ID       = the Azure AD tenant (directory) ID
#   AZURE_CLIENT_SECRET   = the service principal's client secret  <-- SECRET
#   AZURE_SUBSCRIPTION_ID = subscription holding the DNS zone
#   AZURE_RESOURCE_GROUP  = resource group holding the sandboxservers.games zone
#
# *** THESE VALUES DO NOT GO IN THIS FILE. *** They live ONLY on the colo box
# in a root-owned chmod-600 env file (default /opt/lore/secrets/azure-dns.env)
# that compose loads via `env_file:` (see compose.yml). This repo is PUBLIC —
# committing AZURE_CLIENT_SECRET would leak DNS-edit rights to the zone.
# The block below is the TEMPLATE for that host file; copy it, do NOT fill it
# in here. See RUNBOOK § "Provision Azure DNS for ACME" and § "Set deploy-time
# secrets on the Debian colo box".
#
#   # ---- /opt/lore/secrets/azure-dns.env  (root:root, chmod 600) ----
#   AZURE_AUTH_METHOD=env
#   AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
#   AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
#   AZURE_CLIENT_SECRET=the-service-principal-secret
#   AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
#   AZURE_RESOURCE_GROUP=dns-rg-holding-the-sandboxservers-games-zone
#   # -----------------------------------------------------------------
#
# Higher-security variant: lego also honors the `_FILE` suffix on any of these
# (e.g. AZURE_CLIENT_SECRET_FILE=/run/secrets/azure_client_secret) to read the
# value from a file instead of the env. Use it if you'd rather keep the secret
# out of an env file entirely; you must then add that file mount to compose.
# The env_file approach is the shipped default — fewer moving parts at 2am.
#
# Path to the host env file compose reads. Only the PATH is committed here.
AZURE_DNS_ENV_FILE=/opt/lore/secrets/azure-dns.env

# How often the sidecar checks for renewal, and how close to expiry it
# renews. Daily check, renew within 30 days of expiry (lego's check is a
# no-op until then, so a daily loop is cheap and reboot-resilient).
RENEW_INTERVAL_SECONDS=86400
RENEW_WITHIN_DAYS=30

# --- lore-server image pin ------------------------------------------------
# The immutable dated tag the colo runs. See RUNBOOK § Deploy for choosing
# it. Never :latest, never the rolling latest-prerelease pointer in prod.
LORE_IMAGE=ghcr.io/sandboxservers/lore-server:latest-prerelease
