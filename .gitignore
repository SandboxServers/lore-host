# Local secrets / certs — NEVER commit these. They are mounted into the
# container at deploy time from the colo host, not baked into the image.
*.pem
*.key
*.crt
secrets/
.env
.env.*
!.env.example

# Local TLS material generated by scripts/make-certs.sh
certs/

# Backups staged locally before they go offsite — these can be large and
# contain the team's entire VCS history. Keep them out of git.
backups/
*.tar.zst
*.tar.gz

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
